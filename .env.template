# =============================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE — simulador-reforma-tributaria
# =============================================================
# ATENÇÃO: Este arquivo é seguro para commitar (sem valores reais).
# Copie para .env.local e preencha com as credenciais corretas.
# NUNCA commite o .env.local real.
# =============================================================

# -------------------------------------------------------------
# BANCO DE DADOS — Neon PostgreSQL
# Obter em: console.neon.tech → seu projeto → Connection Details
# -------------------------------------------------------------
DATABASE_URL=                        # Pooled (uso em runtime: API routes, queries)
DATABASE_URL_UNPOOLED=               # Unpooled (uso em migrations: drizzle-kit push/generate)

# -------------------------------------------------------------
# AUTENTICAÇÃO — Clerk
# Obter em: dashboard.clerk.com → seu app → API Keys
# -------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=   # pk_live_... (visível no frontend)
CLERK_SECRET_KEY=                    # sk_live_... (apenas no servidor, nunca expor)

# -------------------------------------------------------------
# IA — Anthropic (Claude)
# Obter em: console.anthropic.com → API Keys
# Modelos usados: claude-haiku-4-5-20251001, claude-sonnet-4-6
# -------------------------------------------------------------
ANTHROPIC_API_KEY=                   # sk-ant-...

# -------------------------------------------------------------
# IA — Voyage AI (Embeddings RAG)
# Obter em: dash.voyageai.com → API Keys
# Modelo usado: voyage-law-2 (1024 dimensões)
# -------------------------------------------------------------
VOYAGE_API_KEY=                      # pa-...

# -------------------------------------------------------------
# FILAS — Upstash Redis (BullMQ)
# Obter em: console.upstash.com → seu banco Redis → REST API
# -------------------------------------------------------------
UPSTASH_REDIS_REST_URL=              # https://....upstash.io
UPSTASH_REDIS_REST_TOKEN=            # Token de acesso REST

# -------------------------------------------------------------
# STORAGE — Vercel Blob
# Gerado automaticamente pelo Vercel ao adicionar Blob Storage
# Vercel Dashboard → Storage → Blob → seu store → .env.local
# -------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=               # vercel_blob_rw_...

# -------------------------------------------------------------
# SEGURANÇA — Cron Secret
# Protege /api/cron/* de chamadas não autorizadas
# Gere com: openssl rand -base64 32
# Configure também no Vercel Dashboard → Settings → Crons
# -------------------------------------------------------------
CRON_SECRET=                         # string aleatória longa (mín. 32 chars)

# -------------------------------------------------------------
# APIs EXTERNAS — Enriquecimento de CNPJ
# Sem autenticação — apenas URLs. Não alterar salvo mudança de provider.
# -------------------------------------------------------------
BRASIL_API_URL=https://brasilapi.com.br/api/cnpj/v1
RECEITA_WS_URL=https://www.receitaws.com.br/v1/cnpj
